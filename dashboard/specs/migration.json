{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Матрица миграции между корзинами просрочки от прошлого среза к последнему. Источник: reporting.v_dpd_migration.",
  "title": {
    "text": "Миграция просрочки за месяц",
    "subtitle": "Куда перешла сумма каждой корзины: строка — было на прошлый срез, столбец — стало на последний"
  },
  "data": {"url": "data/dpd_migration.json"},
  "transform": [
    {"calculate": "time(toDate(datum.report_date))", "as": "t"},
    {"joinaggregate": [{"op": "max", "field": "t", "as": "t_last"}]},
    {"filter": "datum.t === datum.t_last"},
    {"calculate": "slice(datum.prev_date, 8, 10) + '.' + slice(datum.prev_date, 5, 7) + '.' + slice(datum.prev_date, 0, 4)", "as": "prev_label"},
    {"calculate": "slice(datum.report_date, 8, 10) + '.' + slice(datum.report_date, 5, 7) + '.' + slice(datum.report_date, 0, 4)", "as": "cur_label"},
    {"calculate": "[format(datum.from_share, '.0%'), datum.loans + ' кред.']", "as": "cell_text"},
    {"calculate": "datum.from_amount_kzt / 1e9", "as": "from_bn"},
    {"calculate": "datum.to_amount_kzt / 1e9", "as": "to_bn"}
  ],
  "width": "container",
  "height": {"step": 50},
  "encoding": {
    "x": {
      "field": "to_state",
      "type": "ordinal",
      "sort": {"field": "to_order", "op": "min"},
      "title": "Стало, дней просрочки",
      "scale": {"paddingInner": 0.06},
      "axis": {"orient": "top", "labelAngle": 0, "domain": false, "ticks": false, "labelPadding": 6, "labelFontSize": 13}
    },
    "y": {
      "field": "from_state",
      "type": "ordinal",
      "sort": {"field": "from_order", "op": "min"},
      "title": "Было, дней просрочки",
      "scale": {"paddingInner": 0.06},
      "axis": {"domain": false, "ticks": false, "labelPadding": 8, "labelFontSize": 13}
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "cornerRadius": 3},
      "encoding": {
        "color": {
          "field": "from_share",
          "type": "quantitative",
          "scale": {"domain": [0, 1]},
          "legend": null
        },
        "tooltip": [
          {"field": "from_state", "title": "Было, дней просрочки"},
          {"field": "to_state", "title": "Стало, дней просрочки"},
          {"field": "prev_label", "title": "Прошлый срез"},
          {"field": "cur_label", "title": "Последний срез"},
          {"field": "loans", "title": "Кредитов"},
          {"field": "from_share", "title": "Доля суммы корзины", "format": ".1%"},
          {"field": "from_bn", "title": "Сумма на прошлый срез, млрд ₸", "format": ",.2f"},
          {"field": "to_bn", "title": "Сумма на последний срез, млрд ₸", "format": ",.2f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.from_share < 0.5"}],
      "mark": {"type": "text", "style": "cell-label", "lineHeight": 15},
      "encoding": {"text": {"field": "cell_text"}}
    },
    {
      "transform": [{"filter": "datum.from_share >= 0.5"}],
      "mark": {"type": "text", "style": "cell-label-strong", "lineHeight": 15},
      "encoding": {"text": {"field": "cell_text"}}
    }
  ]
}
