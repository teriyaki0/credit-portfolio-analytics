{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Динамика долей риска между срезами (dumbbell). Источник: reporting.v_risk_metrics_change.",
  "title": {"text": "Динамика рисков", "subtitle": "Доля портфеля на каждую дату среза"},
  "data": {"url": "data/risk_metrics_change.json"},
  "transform": [
    {"filter": "datum.kind === 'ratio'"},
    {"calculate": "slice(datum.report_date, 8, 10) + '.' + slice(datum.report_date, 5, 7) + '.' + slice(datum.report_date, 0, 4)", "as": "date_label"},
    {"calculate": "datum.change === null ? '' : (datum.change > 0 ? '+' : datum.change < 0 ? '−' : '') + format(abs(datum.change) * 100, '.2f') + ' п.п.'", "as": "change_text"}
  ],
  "width": "container",
  "height": {"step": 52},
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {"field": "sort_order", "op": "min"},
      "title": null,
      "axis": {"domain": false, "ticks": false, "labelPadding": 10, "grid": false}
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "style": "dumbbell-link"},
      "encoding": {
        "x": {"aggregate": "min", "field": "value", "type": "quantitative"},
        "x2": {"aggregate": "max", "field": "value"}
      }
    },
    {
      "mark": {"type": "point"},
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": null,
          "scale": {"zero": true},
          "axis": {"format": ".0%", "tickCount": 5}
        },
        "color": {"field": "date_label", "type": "ordinal", "title": "Дата среза"},
        "tooltip": [
          {"field": "label", "title": "Метрика"},
          {"field": "date_label", "title": "Дата среза"},
          {"field": "value", "title": "Доля портфеля", "format": ".2%"},
          {"field": "change_text", "title": "Изменение к прошлому срезу"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.prev_date !== null && datum.change < 0"}],
      "mark": {"type": "text", "style": "value-label", "align": "right", "dx": -10},
      "encoding": {"x": {"field": "value", "type": "quantitative"}, "text": {"field": "value", "format": ".2%"}}
    },
    {
      "transform": [{"filter": "datum.prev_date !== null && datum.change >= 0"}],
      "mark": {"type": "text", "style": "value-label", "align": "left", "dx": 10},
      "encoding": {"x": {"field": "value", "type": "quantitative"}, "text": {"field": "value", "format": ".2%"}}
    }
  ]
}
