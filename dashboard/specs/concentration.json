{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Топ-10 групп связанных заёмщиков на последнюю дату среза. Источник: reporting.v_group_exposure.",
  "title": {"text": "Концентрация: топ-10 групп", "subtitle": "Доля в портфеле на последнюю дату среза"},
  "data": {"url": "data/top_groups.json"},
  "transform": [
    {"calculate": "time(toDate(datum.report_date))", "as": "t"},
    {"joinaggregate": [{"op": "max", "field": "t", "as": "t_last"}]},
    {"filter": "datum.t === datum.t_last"},
    {"calculate": "datum.group_id + ' · заёмщиков: ' + datum.borrowers", "as": "group_label"},
    {"calculate": "datum.exposure_kzt / 1e9", "as": "exposure_bn"},
    {"calculate": "datum.npl_kzt / 1e9", "as": "npl_bn"},
    {"calculate": "datum.share * 1.15", "as": "share_with_label"}
  ],
  "width": "container",
  "height": {"step": 26},
  "encoding": {
    "y": {
      "field": "group_label",
      "type": "nominal",
      "sort": {"field": "exposure_rank", "op": "min"},
      "title": null,
      "axis": {"domain": false, "ticks": false, "labelPadding": 8}
    },
    "x": {
      "field": "share",
      "type": "quantitative",
      "title": null,
      "axis": {"format": ".1%", "tickCount": 4}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar"},
      "encoding": {
        "tooltip": [
          {"field": "exposure_rank", "title": "Место"},
          {"field": "group_id", "title": "Группа"},
          {"field": "borrowers", "title": "Заёмщиков"},
          {"field": "loans", "title": "Кредитов"},
          {"field": "exposure_bn", "title": "Экспозиция, млрд ₸", "format": ",.2f"},
          {"field": "share", "title": "Доля портфеля", "format": ".2%"},
          {"field": "npl_bn", "title": "Из неё NPL, млрд ₸", "format": ",.2f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "style": "value-label", "align": "left", "dx": 6},
      "encoding": {"text": {"field": "share", "format": ".1%"}}
    },
    {
      "description": "Невидимая метка: запас по оси под подпись самой длинной полосы.",
      "mark": {"type": "tick", "opacity": 0},
      "encoding": {"x": {"field": "share_with_label", "type": "quantitative"}}
    }
  ]
}
