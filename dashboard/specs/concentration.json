{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Топ-10 групп связанных заёмщиков на последнюю дату среза: работающая часть и NPL. Источник: reporting.v_group_exposure.",
  "title": {"text": "Концентрация: топ-10 групп", "subtitle": "Доля группы в портфеле на последнюю дату; оранжевым — её NPL"},
  "data": {"url": "data/top_groups.json"},
  "transform": [
    {"calculate": "time(toDate(datum.report_date))", "as": "t"},
    {"joinaggregate": [{"op": "max", "field": "t", "as": "t_last"}]},
    {"filter": "datum.t === datum.t_last"},
    {"calculate": "datum.group_id + ' · заёмщиков: ' + datum.borrowers", "as": "group_label"},
    {"calculate": "datum.npl_kzt / datum.exposure_kzt", "as": "npl_in_group"},
    {"calculate": "datum.share * datum.npl_in_group", "as": "npl_share"},
    {"calculate": "datum.share - datum.npl_share", "as": "performing_share"},
    {"calculate": "datum.exposure_kzt / 1e9", "as": "exposure_bn"},
    {"calculate": "datum.npl_kzt / 1e9", "as": "npl_bn"},
    {"calculate": "datum.npl_in_group >= 0.2", "as": "is_problem"},
    {"calculate": "format(datum.share, '.1%') + (datum.is_problem ? ' · NPL ' + format(datum.npl_in_group, '.0%') : '')", "as": "bar_label"},
    {"calculate": "datum.share * (datum.is_problem ? 1.6 : 1.15)", "as": "share_with_label"}
  ],
  "width": "container",
  "height": {"step": 26},
  "encoding": {
    "y": {
      "field": "group_label",
      "type": "nominal",
      "sort": {"field": "exposure_rank", "op": "min"},
      "title": null,
      "axis": {"domain": false, "ticks": false, "labelPadding": 8}
    }
  },
  "layer": [
    {
      "transform": [
        {"fold": ["performing_share", "npl_share"], "as": ["part_key", "part_share"]},
        {"calculate": "datum.part_key === 'npl_share' ? 'NPL' : 'Работающая часть'", "as": "part"},
        {"calculate": "datum.part_key === 'npl_share' ? 2 : 1", "as": "part_order"}
      ],
      "mark": {"type": "bar"},
      "encoding": {
        "x": {
          "field": "part_share",
          "type": "quantitative",
          "stack": "zero",
          "title": null,
          "axis": {"format": ".1%", "tickCount": 4}
        },
        "color": {
          "field": "part",
          "type": "nominal",
          "title": null,
          "scale": {"domain": ["Работающая часть", "NPL"], "scheme": "perf-npl"}
        },
        "order": {"field": "part_order"},
        "tooltip": [
          {"field": "exposure_rank", "title": "Место"},
          {"field": "group_id", "title": "Группа"},
          {"field": "borrowers", "title": "Заёмщиков"},
          {"field": "loans", "title": "Кредитов"},
          {"field": "exposure_bn", "title": "Экспозиция, млрд ₸", "format": ",.2f"},
          {"field": "share", "title": "Доля портфеля", "format": ".2%"},
          {"field": "npl_bn", "title": "Из неё NPL, млрд ₸", "format": ",.2f"},
          {"field": "npl_in_group", "title": "NPL внутри группы", "format": ".0%"}
        ]
      }
    },
    {
      "transform": [{"filter": "!datum.is_problem"}],
      "mark": {"type": "text", "style": "value-label", "align": "left", "dx": 6},
      "encoding": {"x": {"field": "share", "type": "quantitative"}, "text": {"field": "bar_label"}}
    },
    {
      "transform": [{"filter": "datum.is_problem"}],
      "mark": {"type": "text", "style": "value-label-strong", "align": "left", "dx": 6},
      "encoding": {"x": {"field": "share", "type": "quantitative"}, "text": {"field": "bar_label"}}
    },
    {
      "description": "Невидимая метка: запас по оси под подпись самой длинной полосы.",
      "mark": {"type": "tick", "opacity": 0},
      "encoding": {"x": {"field": "share_with_label", "type": "quantitative"}}
    }
  ]
}
